# Backend proxy base URL (no trailing slash, no /v1). Empty = on-device only.
#   Android emulator   -> http://10.0.2.2:8001   (needs cleartext, see README)
#   Real phone, tunnel -> https://<your-id>.ngrok-free.app
#   Real phone, LAN    -> http://<pc-lan-ip>:8001 (needs cleartext + firewall rule)
API_PROXY_URL=
# Same value as PROXY_API_KEY in visionassist_backend/.env.
# NOTE: it ships inside the APK - it gates casual abuse, it is not a real secret.
PROXY_API_KEY=
# The backend is used only when this is true AND the two values above are set.
ENABLE_REMOTE_QA=false
# Seconds to wait for the backend before falling back to on-device logic.
REMOTE_TIMEOUT_SECONDS=20
DEFAULT_LOCALE=id-ID
TTS_SPEECH_RATE=0.5
